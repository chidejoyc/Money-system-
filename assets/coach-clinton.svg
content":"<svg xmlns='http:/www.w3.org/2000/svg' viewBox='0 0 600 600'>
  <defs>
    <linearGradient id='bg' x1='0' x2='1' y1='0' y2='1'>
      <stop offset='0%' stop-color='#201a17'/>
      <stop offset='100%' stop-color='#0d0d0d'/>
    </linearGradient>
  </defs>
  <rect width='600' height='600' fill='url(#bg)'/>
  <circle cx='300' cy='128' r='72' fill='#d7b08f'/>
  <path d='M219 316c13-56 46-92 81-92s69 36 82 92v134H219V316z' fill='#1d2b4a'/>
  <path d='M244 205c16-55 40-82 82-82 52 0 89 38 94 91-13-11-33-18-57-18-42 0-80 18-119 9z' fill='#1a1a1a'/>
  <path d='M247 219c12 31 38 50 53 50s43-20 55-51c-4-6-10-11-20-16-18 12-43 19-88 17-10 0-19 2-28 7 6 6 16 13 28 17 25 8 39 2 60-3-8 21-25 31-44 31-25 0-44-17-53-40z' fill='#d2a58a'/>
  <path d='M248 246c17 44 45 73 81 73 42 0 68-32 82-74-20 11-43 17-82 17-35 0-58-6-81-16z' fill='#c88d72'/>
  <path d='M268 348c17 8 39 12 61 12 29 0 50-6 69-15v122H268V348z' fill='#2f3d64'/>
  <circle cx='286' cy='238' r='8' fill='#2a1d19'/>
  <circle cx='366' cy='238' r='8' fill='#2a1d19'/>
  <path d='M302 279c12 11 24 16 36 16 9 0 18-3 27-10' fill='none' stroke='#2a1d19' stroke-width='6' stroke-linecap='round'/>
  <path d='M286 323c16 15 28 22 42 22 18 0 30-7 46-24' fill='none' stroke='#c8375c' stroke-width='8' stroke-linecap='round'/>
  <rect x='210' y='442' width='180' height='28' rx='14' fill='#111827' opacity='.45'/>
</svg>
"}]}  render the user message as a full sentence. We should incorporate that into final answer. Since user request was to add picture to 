  <style>
    :root {
      --ink:#090909;
      --panel:#11110f;
      --panel2:#181713;
      --cream:#f5f0e6;
      --muted:#aaa49a;
      --gold:#c9a227;
      --gold2:#e4c65c;
      --line:rgba(201,162,39,.25);
      --rose:#d77b8a;
      --rose-deep:#c85b6e;
      --shadow:rgba(0,0,0,.35);
    }

    * { box-sizing:border-box; margin:0; padding:0; }
    html { scroll-behavior:smooth; }
    body {
      background:var(--ink);
      color:var(--cream);
      font:16px/1.65 "DM Sans", sans-serif;
      overflow-x:hidden;
    }
    a { color:inherit; text-decoration:none; }
    img { max-width:100%; display:block; }
    h1,h2,h3 { font-family:"Playfair Display", serif; line-height:1.08; color:#fff; }
    h1 { font-size:clamp(2.8rem, 6vw, 5rem); }
    h2 { font-size:clamp(2rem, 4vw, 3rem); margin-bottom:14px; }
    p { color:var(--muted); }
    .wrap { width:min(1120px, calc(100% - 40px)); margin-inline:auto; }
    .eyebrow {
      color:var(--gold2);
      font-size:.68rem;
      font-weight:700;
      letter-spacing:.22em;
      text-transform:uppercase;
      margin-bottom:16px;
    }
    .section { padding:110px 0; }
    .dark { background:var(--panel); }
    .nav {
      position:sticky;
      top:0;
      z-index:30;
      background:rgba(9,9,9,.88);
      backdrop-filter:blur(12px);
      border-bottom:1px solid rgba(255,255,255,.08);
    }
    .nav-inner {
      display:flex;
      align-items:center;
      justify-content:space-between;
      min-height:72px;
      gap:20px;
    }
    .brand {
      font-size:.85rem;
      font-weight:700;
      letter-spacing:.12em;
      text-transform:uppercase;
    }
    .brand b { color:var(--gold2); }
    .nav a:last-child {
      color:var(--muted);
      font-size:.85rem;
    }

    .hero {
      min-height:72vh;
      display:grid;
      place-items:center;
      position:relative;
      overflow:hidden;
      background:radial-gradient(ellipse at 80% 20%, rgba(201,162,39,.14), transparent 33%), var(--ink);
    }
    .hero::before {
      content:"";
      position:absolute;
      width:650px;
      height:650px;
      border:1px solid rgba(201,162,39,.12);
      border-radius:50%;
      right:-280px;
      top:-110px;
    }
    .hero-grid {
      display:grid;
      grid-template-columns:1.15fr .85fr;
      align-items:center;
      gap:65px;
      position:relative;
      z-index:1;
    }
    .hero-copy > p {
      max-width:560px;
      font-size:1.08rem;
      margin-bottom:26px;
      color:var(--muted);
    }
    .gold { color:var(--gold2); }
    .price {
      color:#fff;
      font-size:1.7rem;
      font-weight:700;
      margin-bottom:22px;
    }
    .price small {
      color:var(--muted);
      font-size:.72rem;
      font-weight:600;
      margin-left:6px;
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .actions {
      display:flex;
      flex-wrap:wrap;
      gap:12px;
      margin-top:14px;
      margin-bottom:34px;
    }
    .btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:52px;
      padding:14px 23px;
      border-radius:12px;
      border:1px solid var(--gold);
      font-weight:700;
      transition:transform .25s ease, background .25s ease, color .25s ease;
    }
    .btn:hover { transform:translateY(-2px); }
    .btn.primary { background:var(--gold); color:#090909; }
    .btn.secondary { border-color:rgba(255,255,255,.2); color:var(--cream); }
    .badges {
      display:flex;
      flex-wrap:wrap;
      gap:12px;
    }
    .badge {
      border:1px solid var(--line);
      background:rgba(255,255,255,.02);
      padding:7px 12px;
      border-radius:999px;
      font-size:.7rem;
      color:var(--muted);
      letter-spacing:.08em;
      text-transform:uppercase;
    }
    .badge strong { color:var(--gold2); }

    .book-stage {
      display:grid;
      place-items:center;
      position:relative;
    }
    .cover-wrap {
      position:relative;
      width:min(330px, 82%);
      transform:rotate(2deg);
    }
    .cover-wrap::after {
      content:"";
      position:absolute;
      inset:10px -18px -18px 18px;
      background:rgba(0,0,0,.35);
      filter:blur(18px);
      z-index:-1;
      opacity:.8;
    }
    .book-cover {
      width:100%;
      aspect-ratio:3/4;
      object-fit:cover;
      border:1px solid var(--gold);
      border-radius:12px;
      box-shadow:0 35px 60px rgba(0,0,0,.35);
    }
    .cover-placeholder {
      display:grid;
      place-items:center;
      text-align:center;
      padding:30px 18px;
      background:linear-gradient(135deg, #291f12, #050505);
      color:var(--gold2);
      border:1px solid var(--gold);
      border-radius:12px;
      font-family:"Playfair Display", serif;
      min-height:100%;
      box-shadow:0 35px 60px rgba(0,0,0,.35);
    }
    .cover-placeholder small { letter-spacing:.14em; }

    .intro {
      max-width:650px;
      margin-bottom:30px;
      color:var(--muted);
      font-size:1.08rem;
    }
    .grid4 {
      display:grid;
      grid-template-columns:repeat(4, minmax(0,1fr));
      gap:20px;
      margin-top:28px;
    }
    .card {
      background:var(--panel2);
      border:1px solid var(--line);
      border-radius:18px;
      padding:24px 18px;
    }
    .card .number {
      width:42px;
      height:42px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:rgba(201,162,39,.1);
      color:var(--gold2);
      font-weight:700;
      margin-bottom:18px;
    }
    .card h3 { font-size:1.3rem; margin-bottom:8px; }
    .card p { font-size:.95rem; }

    .story {
      display:grid;
      grid-template-columns:1fr 1.2fr;
      gap:70px;
      align-items:center;
    }
    .quote {
      border-left:3px solid var(--gold);
      padding:8px 0 8px 22px;
      font-size: clamp(1.3rem, 2vw, 1.8rem);
      line-height:1.5;
      color:#fff;
      font-family:"Playfair Display", serif;
      font-style:italic;
    }
    .quote cite {
      display:block;
      margin-top:18px;
      font-size:.85rem;
      font-style:normal;
      font-family:"DM Sans", sans-serif;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:var(--gold2);
    }

    .features {
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:18px;
    }
    .feature {
      display:flex;
      gap:14px;
      padding:22px;
      border-radius:18px;
      background:var(--panel2);
      border:1px solid var(--line);
    }
    .check {
      width:32px;
      height:32px;
      border-radius:50%;
      display:grid;
      place-items:center;
      background:rgba(201,162,39,.12);
      color:var(--gold2);
      font-weight:700;
      flex-shrink:0;
    }
    .feature h3 { font-size:1.35rem; margin-bottom:6px; }

    .audience {
      display:grid;
      grid-template-columns:repeat(5, minmax(0,1fr));
      gap:18px;
      margin-top:30px;
    }
    .audience .card {
      text-align:center;
      min-height:170px;
      display:grid;
      place-items:center;
      gap:14px;
    }
    .audience-icon {
      font-size:2rem;
      color:var(--gold2);
    }

    .author {
      display:grid;
      grid-template-columns:220px 1fr;
      gap:42px;
      align-items:center;
    }
    .author-photo-frame {
      width:220px;
      height:220px;
      display:grid;
      place-items:center;
      border-radius:24px;
      overflow:hidden;
      border:1px solid var(--gold);
      background:linear-gradient(135deg, #241d1f, #111111);
      box-shadow:0 25px 50px rgba(0,0,0,.28);
    }
    .author-photo {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:center top;
      display:block;
      background:radial-gradient(circle at 50% 25%, rgba(255,255,255,.18), transparent 18%), #0e0e0d;
    }
    .author-photo-fallback {
      display:grid;
      place-items:center;
      width:100%;
      height:100%;
      font: 4.4rem/1 "Playfair Display", serif;
      color:var(--gold2);
      background:linear-gradient(145deg, rgba(201,162,39,.18), rgba(17,17,17,.96));
    }

    .trust {
      display:grid;
      grid-template-columns:repeat(3, minmax(0,1fr));
      gap:18px;
      margin-top:30px;
    }
    .trust .card {
      min-height:220px;
      display:flex;
      flex-direction:column;
      justify-content:start;
      gap:14px;
    }
    .trust-icon {
      font-size:1.8rem;
      color:var(--gold2);
    }

    .faq {
      max-width:820px;
      margin-top:30px;
    }
    .faq-item {
      border-top:1px solid rgba(255,255,255,.12);
      padding:20px 0;
    }
    .faq-item:last-child { border-bottom:1px solid rgba(255,255,255,.12); }
    .faq-question {
      width:100%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      background:none;
      border:none;
      color:#fff;
      font:600 1.05rem "DM Sans", sans-serif;
      text-align:left;
      cursor:pointer;
      padding:0;
    }
    .faq-question span {
      display:grid;
      place-items:center;
      width:28px;
      height:28px;
      border:1px solid var(--line);
      border-radius:50%;
      color:var(--gold2);
      font-size:1.2rem;
      transition:transform .3s ease;
    }
    .faq-item.open .faq-question span { transform:rotate(45deg); }
    .faq-answer {
      display:grid;
      grid-template-rows:0fr;
      transition:grid-template-rows .3s ease;
    }
    .faq-item.open .faq-answer { grid-template-rows:1fr; }
    .faq-answer > div {
      overflow:hidden;
      padding-top:12px;
      color:var(--muted);
    }

    .final {
      text-align:center;
      background:linear-gradient(135deg, rgba(201,162,39,.08), rgba(25,25,23,.4));
      border-top:1px solid var(--line);
      border-bottom:1px solid var(--line);
    }
    .final .price {
      margin:18px 0 22px;
    }
    .final .actions { justify-content:center; }

    footer {
      padding:30px 0 90px;
      color:var(--muted);
      font-size:.8rem;
    }
    footer .wrap { display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap; }

    .mobile-cta {
      display:none;
      position:fixed;
      left:0;
      right:0;
      bottom:0;
      padding:10px 14px 22px;
      background:rgba(9,9,9,.92);
      border-top:1px solid rgba(255,255,255,.08);
      z-index:20;
    }
    .mobile-cta .btn { width:100%; }

    @media (max-width: 900px) {
      .hero-grid, .story, .author { grid-template-columns:1fr; gap:42px; }
      .hero-copy { text-align:center; }
      .hero-copy > p { margin-inline:auto; }
      .actions { justify-content:center; }
      .grid4, .features, .trust { grid-template-columns:repeat(2, minmax(0,1fr)); }
      .audience { grid-template-columns:repeat(2, minmax(0,1fr)); }
      .author-photo-frame { margin-inline:auto; }
    }

    @media (max-width: 520px) {
      .wrap { width:calc(100% - 30px); }
      .section { padding:76px 0; }
      .grid4, .features, .trust, .audience { grid-template-columns:1fr; }
      .actions .btn { width:100%; }
      .nav-inner { min-height:64px; }
      .nav a:last-child { display:none; }
      .mobile-cta { display:block; }
      footer { padding-bottom:120px; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior:auto; }
      *, *::before, *::after { transition:none !important; animation:none !important; }
    }
  </style>
</head>
